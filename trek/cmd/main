#!/bin/bash
### fnOS application lifecycle script
set -e

APP_NAME="${TRIM_APPNAME:-com.trek.app}"
APP_DIR="${TRIM_PKGDIR:-${TRIM_APPDEST:-/vol1/@appcenter/com.trek.app}}"

# AppCenter may execute lifecycle scripts from /var/apps/<app>/cmd while the real
# payload lives under /var/apps/<app>/target. Normalize before using compose.
if [ ! -f "$APP_DIR/docker/docker-compose.yml" ] && [ -f "$APP_DIR/target/docker/docker-compose.yml" ]; then
    APP_DIR="$APP_DIR/target"
fi
if [ ! -f "$APP_DIR/docker/docker-compose.yml" ] && [ -f "/var/apps/$APP_NAME/target/docker/docker-compose.yml" ]; then
    APP_DIR="/var/apps/$APP_NAME/target"
fi
if [ ! -f "$APP_DIR/docker/docker-compose.yml" ] && [ -f "/vol1/@appcenter/$APP_NAME/docker/docker-compose.yml" ]; then
    APP_DIR="/vol1/@appcenter/$APP_NAME"
fi

PKG_VAR="${TRIM_PKGVAR:-}"
if [ -z "$PKG_VAR" ]; then
    if [ -e "/var/apps/$APP_NAME/var" ]; then
        PKG_VAR="/var/apps/$APP_NAME/var"
    else
        PKG_VAR="/vol1/@appdata/$APP_NAME"
    fi
fi
PORT="${wizard_access_port:-32679}"

valid_port() {
    [[ "${1:-}" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

prepare_env() {
    valid_port "$PORT" || { echo "Error: invalid TREK port: $PORT" >&2; exit 1; }
    mkdir -p "$PKG_VAR/data" "$PKG_VAR/uploads" "$APP_DIR/docker"
    {
        echo "TRIM_PKGVAR=$PKG_VAR"
        echo "wizard_access_port=$PORT"
    } > "$APP_DIR/docker/.env"
    export TRIM_PKGVAR="$PKG_VAR"
    export wizard_access_port="$PORT"
    export ADMIN_EMAIL="${ADMIN_EMAIL:-admin@trek.local}"
    export ADMIN_PASSWORD="${ADMIN_PASSWORD:-Admin12345}"
    export TZ="${TZ:-Asia/Shanghai}"
    export LOG_LEVEL="${LOG_LEVEL:-info}"
    if [ -z "${ENCRYPTION_KEY:-}" ]; then
        export ENCRYPTION_KEY=$(openssl rand -hex 32)
    fi
}

start() {
    compose_file="$APP_DIR/docker/docker-compose.yml"
    if [ ! -f "$compose_file" ]; then
        echo "Error: docker-compose.yml not found: $compose_file" >&2
        exit 1
    fi

    prepare_env
    cd "$APP_DIR/docker"
    docker compose down --remove-orphans 2>/dev/null || true
    if docker ps -a --format '{{.Names}}' | grep -qx 'trek'; then
        docker rm -f trek >/dev/null 2>&1 || true
    fi
    docker compose up -d

    if command -v psql >/dev/null 2>&1; then
      psql -h /var/run/postgresql -d appcenter -U postgres >/dev/null 2>&1 <<SQL || true
UPDATE app
   SET service_url='http://' || chr(36) || '{host}:${PORT}/',
       status='running',
       is_stop=true,
       is_uninstall=true,
       updated_at=now()
 WHERE app_name='${APP_NAME}';
UPDATE app_service
   SET url='http://' || chr(36) || '{host}:${PORT}/',
       default_url='http://' || chr(36) || '{host}:${PORT}/',
       title='TREK',
       updated_at=now()
 WHERE app_id=(SELECT id FROM app WHERE app_name='${APP_NAME}' LIMIT 1);
INSERT INTO system_config(type,k,v)
SELECT 'appAutoUpdate','${APP_NAME}','false'
WHERE NOT EXISTS (SELECT 1 FROM system_config WHERE type='appAutoUpdate' AND k='${APP_NAME}');
SQL
    fi

    echo "TREK container launch requested on port $PORT"
    exit 0
}

stop() {
    if [ -f "$APP_DIR/docker/docker-compose.yml" ]; then
        cd "$APP_DIR/docker"
        docker compose stop
    else
        docker stop trek 2>/dev/null || true
    fi
}

restart() {
    stop
    start
}

status() {
    if docker ps --filter "name=trek" --filter "status=running" 2>/dev/null | grep -q trek; then
        echo "running"
        exit 0
    else
        echo "stopped"
        exit 3
    fi
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
