#!/bin/bash
# 安装后：初始化端口配置。
# 1.0.x 时代无法绑定特权端口，默认写过 11688；1.1.0 起以 root 绑定后立即降权，
# 可用标准 1688 —— 这里把「没有配置」或「仍是旧默认 11688」迁到 1688，用户自设端口不动。
# （平台升级流程跑 upgrade_callback；CLI 覆盖安装不触发任何回调，故两个回调放同样的迁移。）

PORT_FILE="${TRIM_PKGVAR}/port"
cur=$(head -n 1 "${PORT_FILE}" 2>/dev/null | tr -cd '0-9')
case "${cur}" in
    "")     echo "1688" > "${PORT_FILE}" 2>/dev/null || true ;;
    11688)  echo "1688" > "${PORT_FILE}" 2>/dev/null || true ;;
esac

exit 0
