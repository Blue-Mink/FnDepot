#!/bin/bash
# KMS Activator - vlmcsd 生命周期管理

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/vlmcsd.pid"
VLMCSD="${TRIM_APPDEST}/vlmcsd"

log_msg() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"; }

check_pid() {
    local pid=$1
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

do_status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_pid "$pid"; then return 0; fi
        rm -f "${PID_FILE}"
    fi
    return 3
}

do_start() {
    do_status && { log_msg "vlmcsd 已在运行"; return 0; }
    [ ! -x "${VLMCSD}" ] && { echo "vlmcsd 二进制文件不存在或不可执行" > "${TRIM_TEMP_LOGFILE}"; return 1; }

    log_msg "启动 vlmcsd..."

    # 调试：记录运行用户
    log_msg "运行用户: $(whoami 2>/dev/null || id -un)"
    log_msg "运行命令: ${VLMCSD} -p ${PID_FILE} -L 0.0.0.0:11688 -e"
    log_msg "环境: TRIM_APPDEST=${TRIM_APPDEST}"

    # 用高端口 11688（非特权端口），加 -e 让日志到 stderr 以便捕获
    "${VLMCSD}" -p "${PID_FILE}" -L "0.0.0.0:11688" -e >> "${LOG_FILE}" 2>&1
    rc=$?

    log_msg "vlmcsd 退出码: $rc"
    sleep 1

    if do_status; then
        pid=$(head -n 1 "${PID_FILE}" 2>/dev/null)
        log_msg "vlmcsd 启动成功 (PID=$pid, 端口 11688)"

        # 尝试添加 iptables 转发 1688→11688
        if command -v iptables &>/dev/null; then
            iptables -t nat -C PREROUTING -p tcp --dport 1688 -j REDIRECT --to-port 11688 2>/dev/null || \
            iptables -t nat -A PREROUTING -p tcp --dport 1688 -j REDIRECT --to-port 11688 >> "${LOG_FILE}" 2>&1 && \
            log_msg "iptables 转发 1688→11688 已添加" || \
            log_msg "iptables 转发添加失败（非 root 运行）"
        fi
        return 0
    fi

    # 首次尝试失败，日志里可能已有错误信息
    log_msg "=== vlmcsd stderr ==="
    tail -20 "${LOG_FILE}" >> "${LOG_FILE}" 2>/dev/null || true
    echo "vlmcsd 启动失败，请查看日志：${LOG_FILE}" > "${TRIM_TEMP_LOGFILE}"
    return 1
}

do_stop() {
    log_msg "停止 vlmcsd..."
    # 移除 iptables 转发
    if command -v iptables &>/dev/null; then
        iptables -t nat -C PREROUTING -p tcp --dport 1688 -j REDIRECT --to-port 11688 2>/dev/null && \
        iptables -t nat -D PREROUTING -p tcp --dport 1688 -j REDIRECT --to-port 11688 >> "${LOG_FILE}" 2>&1 || true
    fi

    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_pid "$pid"; then
            kill -TERM "$pid" >> "${LOG_FILE}" 2>&1
            local count=0
            while check_pid "$pid" && [ $count -lt 10 ]; do sleep 1; count=$((count+1)); done
            check_pid "$pid" && kill -KILL "$pid" 2>/dev/null && sleep 1
            log_msg "vlmcsd 已停止"
        fi
        rm -f "${PID_FILE}"
    fi
    return 0
}

case $1 in
start) do_start ;;
stop)  do_stop ;;
status) do_status && exit 0 || exit 3 ;;
*) exit 1 ;;
esac
