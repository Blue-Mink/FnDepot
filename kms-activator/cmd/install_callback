#!/bin/bash
# 安装后设置

# 复制 GVLK 密钥库（如果有）
if [ -f "${TRIM_APPDEST}/vlmcsd.kmd" ]; then
    cp "${TRIM_APPDEST}/vlmcsd.kmd" "${TRIM_PKGVAR}/vlmcsd.kmd" 2>/dev/null || true
fi

# 尝试设置 CAP_NET_BIND_SERVICE 允许绑定 <1024 端口
if command -v setcap &>/dev/null; then
    setcap CAP_NET_BIND_SERVICE=+eip "${TRIM_APPDEST}/vlmcsd" 2>/dev/null || true
fi

exit 0
