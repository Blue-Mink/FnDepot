#!/bin/bash
### fnOS application lifecycle script
set -e

APP_NAME="${TRIM_APPNAME:-com.trek.app}"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
MAIN_SCRIPT="$SCRIPT_DIR/main"
APP_DIR="${TRIM_PKGDIR:-${TRIM_APPDEST:-/vol1/@appcenter/com.trek.app}}"
if [ ! -f "$APP_DIR/docker/docker-compose.yml" ] && [ -f "$APP_DIR/target/docker/docker-compose.yml" ]; then
  APP_DIR="$APP_DIR/target"
fi
if [ ! -f "$APP_DIR/docker/docker-compose.yml" ] && [ -f "/var/apps/$APP_NAME/target/docker/docker-compose.yml" ]; then
  APP_DIR="/var/apps/$APP_NAME/target"
fi
if [ ! -f "$APP_DIR/docker/docker-compose.yml" ] && [ -f "/vol1/@appcenter/$APP_NAME/docker/docker-compose.yml" ]; then
  APP_DIR="/vol1/@appcenter/$APP_NAME"
fi

PKG_VAR="${TRIM_PKGVAR:-}"
if [ -z "$PKG_VAR" ]; then
  if [ -e "/var/apps/$APP_NAME/var" ]; then
    PKG_VAR="/var/apps/$APP_NAME/var"
  else
    PKG_VAR="/vol1/@appdata/$APP_NAME"
  fi
fi
PORT="${wizard_access_port:-32679}"

sync_appcenter_db() {
  command -v psql >/dev/null 2>&1 || return 0
  psql -h /var/run/postgresql -d appcenter -U postgres >/dev/null 2>&1 <<SQL || true
UPDATE app
   SET service_url='http://' || chr(36) || '{host}:${PORT}/',
       status='running',
       is_stop=true,
       is_uninstall=true,
       updated_at=now()
 WHERE app_name='${APP_NAME}';
UPDATE app_service
   SET url='http://' || chr(36) || '{host}:${PORT}/',
       default_url='http://' || chr(36) || '{host}:${PORT}/',
       title='TREK',
       updated_at=now()
 WHERE app_id=(SELECT id FROM app WHERE app_name='${APP_NAME}' LIMIT 1);
INSERT INTO system_config(type,k,v)
SELECT 'appAutoUpdate','${APP_NAME}','false'
WHERE NOT EXISTS (SELECT 1 FROM system_config WHERE type='appAutoUpdate' AND k='${APP_NAME}');
SQL
}

if [ -x "$MAIN_SCRIPT" ]; then
  TRIM_APPNAME="$APP_NAME" TRIM_PKGDIR="$APP_DIR" TRIM_PKGVAR="$PKG_VAR" wizard_access_port="$PORT" "$MAIN_SCRIPT" start || true
fi

sync_appcenter_db
# fnOS creates/updates some app rows after install_callback returns; do a short delayed sync too.
(
  for delay in 3 8 15; do
    sleep "$delay"
    sync_appcenter_db
  done
) >/dev/null 2>&1 &

echo "TREK Docker container is configured on port ${PORT}"
echo "Please visit http://${host}:${PORT}/ to access the web UI"
echo ""
echo "Default credentials:"
echo "  Email: admin@trek.local"
echo "  Password: Admin12345 (please change after first login)"
