#!/bin/bash
### campus-imaotai 安装回调
### 读取 wizard 端口，写入 compose 目录 .env，同步 ui/config 端口。

write_error() {
    local msg="$1"
    if [ -n "$TRIM_TEMP_LOGFILE" ]; then
        echo "安装失败：$msg" > "$TRIM_TEMP_LOGFILE"
    fi
    echo "ERROR: $msg" >&2
    exit 1
}

WEB_PORT="${wizard_access_port:-32681}"
API_PORT="${wizard_api_port:-32682}"
if ! echo "$WEB_PORT" | grep -qE '^[0-9]+$' || [ "$WEB_PORT" -lt 1 ] || [ "$WEB_PORT" -gt 65535 ]; then
    write_error "无效的 Web 端口号：$WEB_PORT"
fi
if ! echo "$API_PORT" | grep -qE '^[0-9]+$' || [ "$API_PORT" -lt 1 ] || [ "$API_PORT" -gt 65535 ]; then
    write_error "无效的 API 端口号：$API_PORT"
fi

COMPOSE_DIR="${TRIM_APPDEST}/docker"
if [ ! -d "$COMPOSE_DIR" ]; then
    write_error "Docker Compose 目录不存在：$COMPOSE_DIR"
fi

# 写入 .env 供 docker-compose 使用
cat > "${COMPOSE_DIR}/.env" <<EOF
WEB_PORT=${WEB_PORT}
API_PORT=${API_PORT}
MYSQL_ROOT_PASSWORD=Campus@123
REDIS_PASSWORD=Campus@123
EOF

# 同步 ui/config 端口
UI_CONFIG="${TRIM_APPDEST}/ui/config"
if [ -f "$UI_CONFIG" ]; then
    sed -i "s/\"port\": \"[0-9]*\"/\"port\": \"${WEB_PORT}\"/" "$UI_CONFIG"
fi

echo "campus-imaotai install OK, web=${WEB_PORT} api=${API_PORT}"
exit 0