#!/bin/bash
set -e

APP_NAME="${TRIM_APPNAME:-com.trek.app}"
APP_ID="${TRIM_APP_ID:-109}"
APP_DIR="${TRIM_APPDEST:-${TRIM_PKGDIR:-/vol1/@appcenter/com.trek.app}}"
if [ ! -f "$APP_DIR/docker/docker-compose.yml" ] && [ -f "$APP_DIR/target/docker/docker-compose.yml" ]; then
  APP_DIR="$APP_DIR/target"
fi
if [ ! -f "$APP_DIR/docker/docker-compose.yml" ] && [ -f "/var/apps/$APP_NAME/target/docker/docker-compose.yml" ]; then
  APP_DIR="/var/apps/$APP_NAME/target"
fi
if [ ! -f "$APP_DIR/docker/docker-compose.yml" ] && [ -f "/vol1/@appcenter/$APP_NAME/docker/docker-compose.yml" ]; then
  APP_DIR="/vol1/@appcenter/$APP_NAME"
fi
PKG_VAR="${TRIM_PKGVAR:-}"
if [ -z "$PKG_VAR" ]; then
  if [ -e "/var/apps/$APP_NAME/var" ]; then
    PKG_VAR="/var/apps/$APP_NAME/var"
  else
    PKG_VAR="/vol1/@appdata/$APP_NAME"
  fi
fi
PORT="${wizard_access_port:-32679}"

valid_port() {
  [[ "${1:-}" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

valid_port "$PORT" || { echo "ERROR: 无效的 TREK 访问端口：$PORT" >&2; exit 1; }

update_env_file() {
  local f="$1"
  mkdir -p "$(dirname "$f")"
  touch "$f"
  if grep -q '^TRIM_PKGVAR=' "$f"; then
    sed -i "s#^TRIM_PKGVAR=.*#TRIM_PKGVAR=${PKG_VAR}#" "$f"
  else
    printf 'TRIM_PKGVAR=%s\n' "$PKG_VAR" >> "$f"
  fi
  if grep -q '^wizard_access_port=' "$f"; then
    sed -i "s/^wizard_access_port=.*/wizard_access_port=${PORT}/" "$f"
  else
    printf 'wizard_access_port=%s\n' "$PORT" >> "$f"
  fi
}

update_env_file "$APP_DIR/.env"
update_env_file "$APP_DIR/docker/.env"

UI_CONFIG="$APP_DIR/ui/config"
if [ -f "$UI_CONFIG" ]; then
  python3 - "$UI_CONFIG" "$PORT" <<'PY'
import json, sys
path, port = sys.argv[1], sys.argv[2]
with open(path, 'r', encoding='utf-8') as f:
    data = json.load(f)
for group in ('url', '.url'):
    for entry in (data.get(group) or {}).values():
        if isinstance(entry, dict):
            entry['port'] = str(port)
with open(path, 'w', encoding='utf-8') as f:
    json.dump(data, f, ensure_ascii=False, indent=2)
    f.write('\n')
PY
fi

sync_appcenter_db() {
  command -v psql >/dev/null 2>&1 || return 0
  psql -h /var/run/postgresql -d appcenter -U postgres -v ON_ERROR_STOP=0 >/dev/null 2>&1 <<SQL || true
UPDATE app
   SET service_url='http://' || chr(36) || '{host}:${PORT}/',
       status='running', is_stop=true, is_uninstall=true, updated_at=now()
 WHERE app_name='${APP_NAME}' OR id=${APP_ID};
UPDATE app_service
   SET url='http://' || chr(36) || '{host}:${PORT}/',
       default_url='http://' || chr(36) || '{host}:${PORT}/',
       updated_at=now()
 WHERE app_id=(SELECT id FROM app WHERE app_name='${APP_NAME}' OR id=${APP_ID} LIMIT 1);
INSERT INTO system_config(type,k,v)
SELECT 'appAutoUpdate','${APP_NAME}','false'
WHERE NOT EXISTS (SELECT 1 FROM system_config WHERE type='appAutoUpdate' AND k='${APP_NAME}');
SQL
}

sync_appcenter_db

if command -v docker >/dev/null 2>&1 && [ -f "$APP_DIR/docker/docker-compose.yml" ]; then
  export TRIM_PKGVAR="$PKG_VAR"
  export wizard_access_port="$PORT"
  cd "$APP_DIR/docker"
  docker compose -p trek down --remove-orphans 2>/dev/null || true
  if docker ps -a --format '{{.Names}}' | grep -qx 'trek'; then
    docker rm -f trek >/dev/null 2>&1 || true
  fi
  docker compose -p trek up -d
fi

(
  for delay in 3 8 15; do
    sleep "$delay"
    sync_appcenter_db
  done
) >/dev/null 2>&1 &

echo "TREK configuration updated: port=${PORT}"
exit 0
