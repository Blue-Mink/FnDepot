#!/bin/bash
### DockFlare - 主生命周期脚本
### fnOS 通过 docker-project 资源管理 compose 容器；
### 此脚本负责 start/stop/status 汇报。

FILE_PATH="${TRIM_APPDEST}/docker/docker-compose.yaml"
COMPOSE_DIR="${TRIM_APPDEST}/docker"

# 获取 compose 命令
get_compose_cmd() {
    if command -v docker-compose >/dev/null 2>&1; then
        echo "docker-compose"
    elif docker compose version >/dev/null 2>&1; then
        echo "docker compose"
    fi
}

is_docker_running() {
    if [ -f "$FILE_PATH" ]; then
        docker inspect dockflare >/dev/null 2>&1 || return 1
        docker inspect dockflare | grep -q '"Status": "running"' || return 1
        return 0
    fi
    return 1
}

start() {
    # 确保 compose 目录存在
    if [ ! -d "$COMPOSE_DIR" ]; then
        echo "ERROR: compose dir missing: $COMPOSE_DIR" >&2
        return 1
    fi
    # fnOS docker-project 通常自动管理，这里显式 up -d 兜底
    CMD=$(get_compose_cmd)
    if [ -n "$CMD" ]; then
        cd "$COMPOSE_DIR" && $CMD up -d 2>&1 || return 1
    fi
    return 0
}

stop() {
    CMD=$(get_compose_cmd)
    if [ -n "$CMD" ]; then
        cd "$COMPOSE_DIR" && $CMD stop 2>&1 || true
    fi
    return 0
}

case $1 in
start)
    start
    ;;
stop)
    stop
    ;;
status)
    if is_docker_running; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
