[
  {
    "stepTitle": "端口配置",
    "items": [
      {
        "type": "text",
        "field": "wizard_access_port",
        "label": "访问端口",
        "initValue": "32678",
        "rules": [
          {
            "required": true,
            "message": "请输入访问端口"
          },
          {
            "pattern": "^([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
            "message": "端口号必须为 1-65535 之间的数字"
          }
        ],
        "helpText": "设置外部访问端口（默认 32678）。保存后立即生效，桌面图标与「打开」入口会自动同步到新端口。"
      },
      {
        "type": "text",
        "field": "wizard_data_dir",
        "label": "数据目录",
        "initValue": "/vol1/@appdata/global-radio/data",
        "rules": [
          {
            "required": true,
            "message": "请填写数据目录"
          },
          {
            "pattern": "^/",
            "message": "请填写绝对路径，如 /vol1/@appdata/global-radio/data"
          }
        ],
        "helpText": "电台收藏、播放历史等数据存放目录。修改后保存会立即迁移容器数据卷到新目录（原目录数据不自动拷贝，请先手动迁移）。"
      }
    ]
  }
]
